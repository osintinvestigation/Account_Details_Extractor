# Environment file template for IRMS / Email Investigation Report Management System.
# Copy this file to .env and fill in your real values.
# Loaded automatically by webapp.py via python-dotenv.

# ipinfo.io API token
# Sign up at https://ipinfo.io to get a free token (50k requests/month).
# Used to enrich extracted IP addresses with city / region / country /
# ISP / coordinates in IP_Geolocation_Lookup.xlsx.
# When this is empty, the geolocation step is skipped gracefully.
IPINFO_TOKEN=your_ipinfo_token_here